# Local development only (npm run dev). Never commit a real .env.

# Gemini key, used by the server (server/gemini.ts). Not sent to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase web config (public values from Firebase console > Project settings > Your apps).
# Leave blank to use the local mock sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
